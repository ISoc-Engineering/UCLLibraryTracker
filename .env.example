# Copy to .env and fill in. All values are optional; sensible defaults apply.

# Data source: "uclapi" (live) or "mock" (demo). If omitted, the app uses
# "uclapi" when UCLAPI_TOKEN is set, otherwise "mock".
# DATA_SOURCE=mock

# UCL API token — get one free at https://uclapi.com (create an app).
# Required only for the live "uclapi" source.
# UCLAPI_TOKEN=uclapi-xxxx-xxxx-xxxx-xxxx

# HTTP port (default 3000)
# PORT=3000

# Poll interval in milliseconds (default 300000 = 5 minutes)
# POLL_INTERVAL_MS=300000

# Set to "false" to disable the automatic background poller.
# POLL_ENABLED=true
