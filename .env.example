# Copy to .env and fill in. All values are optional; sensible defaults apply.

# Data source: "scrape" (live) or "mock" (demo). If omitted, the app uses
# "scrape" when SCRAPER_URL_TEMPLATE is set, otherwise "mock".
# DATA_SOURCE=mock

# --- Live "scrape" source configuration ---------------------------------
# UCL's study-space feed sits behind Cloudflare, so it can't be fetched from a
# plain server. Use a managed scraping service that renders JS / uses premium
# (residential) proxies to clear the challenge. All of these have free tiers.
#
# SCRAPER_URL_TEMPLATE is the provider's request URL, with placeholders:
#   {url} -> the (URL-encoded) UCL feed URL, injected automatically
#   {key} -> your SCRAPER_API_KEY, injected automatically
# Pick ONE provider template below, uncomment it, and set SCRAPER_API_KEY.
#
# ScraperAPI (https://www.scraperapi.com) — render JS + premium proxies:
# SCRAPER_URL_TEMPLATE=https://api.scraperapi.com/?api_key={key}&render=true&premium=true&url={url}
#
# ScrapingBee (https://www.scrapingbee.com):
# SCRAPER_URL_TEMPLATE=https://app.scrapingbee.com/api/v1/?api_key={key}&render_js=true&premium_proxy=true&url={url}
#
# ZenRows (https://www.zenrows.com):
# SCRAPER_URL_TEMPLATE=https://api.zenrows.com/v1/?apikey={key}&js_render=true&premium_proxy=true&url={url}
#
# SCRAPER_API_KEY=your-provider-api-key

# HTTP port (default 3000)
# PORT=3000

# Poll interval in milliseconds (default 300000 = 5 minutes).
# NOTE: UCL's sensors update every 5 minutes, so polling faster gains nothing.
# On a free scraping tier (~1000 req/month) use a larger interval, e.g.
# 1800000 (30 min) stays well within quota.
# POLL_INTERVAL_MS=300000

# Set to "false" to disable the automatic background poller.
# POLL_ENABLED=true
