# Local settings for `npm run dev` (wrangler dev). Copy to .env (or .dev.vars)
# and fill in. Non-secret defaults live in wrangler.jsonc "vars"; values here
# override them locally. In production, set MAPBOX_TOKEN with
# `npx wrangler secret put MAPBOX_TOKEN` (see README).

# Mapbox public access token (starts with "pk."). Create a free account at
# https://account.mapbox.com, copy the default public token, and paste it here.
# Without it the map can't load.
MAPBOX_TOKEN=pk.your-public-token

# Optional map style (default mapbox://styles/mapbox/streets-v12).
# MAPBOX_STYLE=mapbox://styles/mapbox/satellite-streets-v12

# Data source: "mock" (demo data, default) or "scrape" (live UCL feed, fetched
# directly from UCL; it may be blocked by UCL's Cloudflare bot protection, see
# README).
# DATA_SOURCE=mock

# Seed a few days of demo history into an empty database (mock mode only).
# SEED_DEMO_HISTORY=true
# SEED_DAYS=3
